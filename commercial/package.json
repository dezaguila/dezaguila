{
  "name": "dez-commercial",
  "version": "1.0.0",
  "private": true,
  "description": "Three short commercials for Dez Aguila's portfolio (Noir, Sage, Pop), built with Remotion",
  "scripts": {
    "music": "node music/noir.mjs && node music/sage.mjs && node music/pop.mjs",
    "studio": "npm run music && remotion studio",
    "render": "node scripts/render.mjs",
    "render:vertical": "node scripts/render.mjs --vertical",
    "publish": "node scripts/render.mjs Noir --publish",
    "stills": "node scripts/stills.mjs",
    "check": "node scripts/check-text.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
